{
  "version": 2,
  "settings": {
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px",
      "allowSwitching": true,
      "contentPosition": true
    }
  },
  "styles": {
    "blocks": {
      "core/group": {
        "spacing": {
          "padding": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          }
        },
        "layout": {
          "type": "flex",
          "flexWrap": "nowrap",
          "justifyContent": "center",
          "verticalAlignment": "center"
        }
      }
    }
  }
}
